{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "project.schema.json",
  "title": "Project",
  "description": "카드의 속성(이름표). 화면에서 고르는 단위가 아니다.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "description",
    "domain",
    "is_synthetic"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^proj_[a-z0-9_]+$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "domain": {
      "enum": [
        "marketing",
        "engineering"
      ]
    },
    "is_synthetic": {
      "type": "boolean"
    }
  }
}
