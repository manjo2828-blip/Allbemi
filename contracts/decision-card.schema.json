{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "decision-card.schema.json",
  "title": "DecisionCard",
  "description": "결정 1개 = 카드 1장. 업무 기록 카드(work)와 인수인계 카드(handover) 두 종류가 있다. 값 정의와 무결성 규칙은 conventions.md 참고.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "project_id",
    "topic",
    "decision",
    "rationale",
    "rejected_alternatives",
    "owner",
    "decided_at",
    "status",
    "supersedes",
    "superseded_by",
    "confidence",
    "needs_review",
    "origin",
    "evidence",
    "attachments",
    "kind",
    "process",
    "source_card_ids"
  ],
  "properties": {
    "id": {
      "$ref": "#/$defs/card_id"
    },
    "project_id": {
      "$ref": "#/$defs/project_id"
    },
    "kind": {
      "enum": [
        "work",
        "handover"
      ],
      "description": "work=업무 기록 카드(평소 자동 생성, 과정 포함), handover=인수인계 카드(업무 기록 카드에서 만든 초안을 다듬은 것)"
    },
    "topic": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$",
      "description": "같은 주제의 카드를 묶는 키 (예: launch_date). 검색 질의 재작성과 평가에 쓴다."
    },
    "decision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "rationale": {
      "type": "string",
      "minLength": 1,
      "description": "왜 그렇게 정했는가"
    },
    "rejected_alternatives": {
      "type": "array",
      "description": "검토 후 버린 대안. 장면 ①의 '기각된 안' 판정과 기각 이유의 원천.",
      "items": {
        "$ref": "#/$defs/rejected_alternative"
      }
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "decided_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "enum": [
        "active",
        "deprecated",
        "superseded"
      ]
    },
    "supersedes": {
      "oneOf": [
        {
          "$ref": "#/$defs/card_id"
        },
        {
          "type": "null"
        }
      ],
      "description": "이 카드가 대체한 이전 카드"
    },
    "superseded_by": {
      "oneOf": [
        {
          "$ref": "#/$defs/card_id"
        },
        {
          "type": "null"
        }
      ],
      "description": "이 카드를 대체한 새 카드"
    },
    "confidence": {
      "enum": [
        "high",
        "medium",
        "low"
      ]
    },
    "needs_review": {
      "type": "boolean"
    },
    "origin": {
      "enum": [
        "ai_extracted",
        "ai_drafted",
        "human_created",
        "human_edited"
      ]
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/evidence"
      }
    },
    "attachments": {
      "type": "array",
      "description": "카드에 연결된 파일. 파일 본체는 넣지 않고 참조만 둔다.",
      "items": {
        "$ref": "#/$defs/attachment"
      }
    },
    "process": {
      "type": "array",
      "description": "업무 기록 카드의 과정 타임라인(시간순). 인수인계 카드는 빈 배열.",
      "items": {
        "$ref": "#/$defs/process_step"
      }
    },
    "source_card_ids": {
      "type": "array",
      "description": "인수인계 카드가 만들어진 원본 업무 기록 카드. 업무 기록 카드는 빈 배열.",
      "items": {
        "$ref": "#/$defs/card_id"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "superseded"
          }
        }
      },
      "then": {
        "properties": {
          "superseded_by": {
            "type": "string"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "active",
              "deprecated"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "superseded_by": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "confidence": {
            "const": "low"
          }
        }
      },
      "then": {
        "properties": {
          "needs_review": {
            "const": true
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "handover"
          }
        }
      },
      "then": {
        "properties": {
          "source_card_ids": {
            "minItems": 1
          },
          "process": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "work"
          }
        }
      },
      "then": {
        "properties": {
          "source_card_ids": {
            "maxItems": 0
          }
        }
      }
    }
  ],
  "$defs": {
    "card_id": {
      "type": "string",
      "pattern": "^card_[a-z0-9_]+$"
    },
    "project_id": {
      "type": "string",
      "pattern": "^proj_[a-z0-9_]+$"
    },
    "log_id": {
      "type": "string",
      "pattern": "^log_[a-z0-9_]+$"
    },
    "file_id": {
      "type": "string",
      "pattern": "^file_[a-z0-9_]+$"
    },
    "rejected_alternative": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "option",
        "reason_rejected"
      ],
      "properties": {
        "option": {
          "type": "string",
          "minLength": 1
        },
        "reason_rejected": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "log_id",
        "message_index",
        "quote"
      ],
      "properties": {
        "log_id": {
          "$ref": "#/$defs/log_id"
        },
        "message_index": {
          "type": "integer",
          "minimum": 0,
          "description": "log.messages 배열의 위치"
        },
        "quote": {
          "type": "string",
          "minLength": 1,
          "description": "해당 메시지 원문에 실제로 들어 있는 문자열"
        },
        "span": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "description": "메시지 text 안에서 quote의 [시작, 끝) 글자 위치. 원문 하이라이트용(선택)."
        }
      }
    },
    "attachment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file_id",
        "note"
      ],
      "properties": {
        "file_id": {
          "$ref": "#/$defs/file_id"
        },
        "note": {
          "type": "string",
          "description": "이 자료가 이 결정과 어떤 관계인지 한 줄"
        }
      }
    },
    "process_step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "text"
      ],
      "properties": {
        "type": {
          "enum": [
            "attempt",
            "failure",
            "blocker",
            "decision",
            "reversal"
          ],
          "description": "시도 / 실패·기각 / 막힘 / 결정 / 번복"
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "$ref": "#/$defs/evidence",
          "description": "이 단계의 근거 원문 위치(선택)"
        }
      }
    }
  }
}
