{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "decision-card.schema.json",
  "title": "DecisionCard",
  "description": "결정 1개 = 카드 1장. 값 정의와 무결성 규칙은 conventions.md 참고.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id", "project_id", "topic", "decision", "rationale", "rejected_alternatives",
    "owner", "decided_at", "status", "supersedes", "superseded_by",
    "confidence", "needs_review", "origin", "evidence", "attachments"
  ],
  "properties": {
    "id": { "$ref": "#/$defs/card_id" },
    "project_id": { "$ref": "#/$defs/project_id" },
    "topic": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$",
      "description": "같은 주제의 카드를 묶는 키 (예: launch_date). 검색 질의 재작성과 평가에 쓴다."
    },
    "decision": { "type": "string", "minLength": 1, "maxLength": 200 },
    "rationale": { "type": "string", "minLength": 1, "description": "왜 그렇게 정했는가" },
    "rejected_alternatives": {
      "type": "array",
      "description": "검토 후 버린 대안. 장면 ①의 '기각된 안' 판정과 기각 이유의 원천.",
      "items": { "$ref": "#/$defs/rejected_alternative" }
    },
    "owner": { "type": "string", "minLength": 1 },
    "decided_at": { "type": "string", "format": "date-time" },
    "status": { "enum": ["active", "deprecated", "superseded"] },
    "supersedes": { "oneOf": [{ "$ref": "#/$defs/card_id" }, { "type": "null" }], "description": "이 카드가 대체한 이전 카드" },
    "superseded_by": { "oneOf": [{ "$ref": "#/$defs/card_id" }, { "type": "null" }], "description": "이 카드를 대체한 새 카드" },
    "confidence": { "enum": ["high", "medium", "low"] },
    "needs_review": { "type": "boolean" },
    "origin": { "enum": ["ai_extracted", "human_created", "human_edited"] },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/evidence" }
    },
    "attachments": {
      "type": "array",
      "description": "카드에 연결된 파일. 파일 본체는 넣지 않고 참조만 둔다.",
      "items": { "$ref": "#/$defs/attachment" }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "superseded" } } },
      "then": { "properties": { "superseded_by": { "type": "string" } } }
    },
    {
      "if": { "properties": { "status": { "enum": ["active", "deprecated"] } } },
      "then": { "properties": { "superseded_by": { "type": "null" } } }
    },
    {
      "if": { "properties": { "confidence": { "const": "low" } } },
      "then": { "properties": { "needs_review": { "const": true } } }
    }
  ],
  "$defs": {
    "card_id": { "type": "string", "pattern": "^card_[a-z0-9_]+$" },
    "project_id": { "type": "string", "pattern": "^proj_[a-z0-9_]+$" },
    "log_id": { "type": "string", "pattern": "^log_[a-z0-9_]+$" },
    "file_id": { "type": "string", "pattern": "^file_[a-z0-9_]+$" },
    "rejected_alternative": {
      "type": "object",
      "additionalProperties": false,
      "required": ["option", "reason_rejected"],
      "properties": {
        "option": { "type": "string", "minLength": 1 },
        "reason_rejected": { "type": "string", "minLength": 1 }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["log_id", "message_index", "quote"],
      "properties": {
        "log_id": { "$ref": "#/$defs/log_id" },
        "message_index": { "type": "integer", "minimum": 0, "description": "log.messages 배열의 위치" },
        "quote": { "type": "string", "minLength": 1, "description": "해당 메시지 원문에 실제로 들어 있는 문자열" },
        "span": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": { "type": "integer", "minimum": 0 },
          "description": "메시지 text 안에서 quote의 [시작, 끝) 글자 위치. 원문 하이라이트용(선택)."
        }
      }
    },
    "attachment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file_id", "note"],
      "properties": {
        "file_id": { "$ref": "#/$defs/file_id" },
        "note": { "type": "string", "description": "이 자료가 이 결정과 어떤 관계인지 한 줄" }
      }
    }
  }
}
